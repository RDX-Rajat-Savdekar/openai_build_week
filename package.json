{
  "name": "stitch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stitch — the CI failure that fixes itself while you sleep. OpenAI Build Week, Developer Tools track.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm run dev --prefix frontend",
    "build": "tsc -p tsconfig.json && npm run frontend:build",
    "build:api": "tsc -p tsconfig.json",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:install": "npm install --prefix frontend",
    "start": "node dist/server.js",
    "test": "vitest run",
    "testrepo:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-testrepo.ps1",
    "testrepo:open-pr": "powershell -ExecutionPolicy Bypass -File testrepo/scripts/open-feature-pr.ps1",
    "stitch:live-check": "powershell -ExecutionPolicy Bypass -File scripts/verify-stitch-live.ps1",
    "typecheck": "tsc --noEmit",
    "media:build": "node media/scripts/build-assets.mjs",
    "media:gif": "node media/scripts/build-storyboard-gif.mjs",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^9.0.3",
    "openai": "^4.55.0",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "concurrently": "^9.1.2",
    "gifenc": "^1.0.3",
    "png-to-ico": "^3.0.2",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  },
  "vitest": {
    "exclude": ["testrepo/**", "node_modules/**", "frontend/**", "dist/**"]
  }
}
