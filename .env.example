# Copy to .env and fill in. Only the GitHub + Slack + Email vars are
# needed for the MVP demo; the rest are here so the other four CI/CD
# plugins are config-complete even though their API calls are still TODO
# (see plan/stitch-implementation-plan.md, section 5).

PORT=3000

# --- Database (PostgreSQL, via Prisma) ---
# Local dev default (matches `setup.md`'s Postgres setup instructions):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stitch?schema=public"

# --- OpenAI (diagnosis / fix generation) ---
OPENAI_API_KEY=
OPENAI_DIAGNOSIS_MODEL=gpt-4o-mini
OPENAI_FIX_MODEL=gpt-4o

# --- Anthropic / Claude (optional second provider — configure per workspace in Settings) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (optional — configure per workspace in Settings) ---
GEMINI_API_KEY=

# --- Microsoft Copilot / Azure OpenAI (optional — endpoint + deployment + key) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- GitHub Actions plugin (fully wired — required for the demo) ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
DEMO_REPO=Khushalsarode/stitch-test-flow-repo
STITCH_TEST_REPO=Khushalsarode/stitch-test-flow-repo

# --- GitHub OAuth App ("Continue with GitHub" login) ---
# Create at https://github.com/settings/developers -> New OAuth App.
# In dev, callback goes through the Vite proxy so session cookies land on :5173.
APP_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# --- GitLab CI plugin (coded, API calls stubbed) ---
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=

# --- CircleCI plugin (coded, API calls stubbed) ---
CIRCLECI_TOKEN=
CIRCLECI_WEBHOOK_SECRET=

# --- Jenkins plugin (coded, API calls stubbed) ---
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
JENKINS_WEBHOOK_SECRET=

# --- Bitbucket Pipelines plugin (coded, API calls stubbed) ---
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
BITBUCKET_WEBHOOK_SECRET=

# --- Slack notification channel (fully wired — used in the demo) ---
SLACK_WEBHOOK_URL=

# --- Email notification channel (fully wired, SMTP) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
